# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Local simulation state; simulated evidence is regenerated by drills.
# REAL-AWS evidence is kept in git as proof for the report.
.sim/
evidence/*
!evidence/real-aws/

# Terraform (later): state and variables may contain secrets
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# Secrets
.env
*.pem

# Real AWS deployment state and build output
.aws-deploy.json
build/
